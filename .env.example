# Copy to .env.local to report to Sentry from local builds.
# Read by the gui (vite), electron and server (gradle) builds. Real environment variables win.
# Rebuild after changing it, the values are baked in at build time.

# Forces a Sentry release. Without it only clean tagged builds report.
# Source maps are never uploaded for a forced release.
SENTRY_RELEASE=v0.0.0-local

# Keeps local events out of production alerts and release health. Defaults to production.
SENTRY_ENVIRONMENT=development

# Leave a DSN empty to disable that part.
SENTRY_GUI_DSN=
SENTRY_ELECTRON_DSN=
SENTRY_SERVER_DSN=
