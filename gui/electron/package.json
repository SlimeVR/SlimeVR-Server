{
  "name": "@slimevr/gui-electron",
  "version": "0.0.0",
  "author": "SlimeVR Team <contact@slimevr.dev>",
  "homepage": "https://slimevr.dev",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "desktopName": "dev.slimevr.SlimeVR",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build --config electron.vite.config.ts && pnpm --filter @slimevr/gui-app exec vite build --outDir ../electron/out/renderer --emptyOutDir",
    "package": "electron-builder",
    "package:build": "pnpm build && pnpm package",
    "preview": "electron ./out/main/index.js",
    "lint": "tsc --noEmit && prettier --check \"{main,preload,scripts}/**/*.{js,mjs,ts}\"",
    "format": "prettier --write \"{main,preload,scripts}/**/*.{js,mjs,ts}\"",
    "gen:javaversion": "cd resources/java-version/ && javac JavaVersion.java && jar cvfe JavaVersion.jar JavaVersion JavaVersion.class"
  },
  "dependencies": {
    "@slimevr/gui-app": "workspace:*",
    "@slimevr/gui-shared": "workspace:*",
    "@xhayper/discord-rpc": "^1.3.0",
    "commander": "^14.0.3",
    "glob": "^13.0.3",
    "open": "^11.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0"
  },
  "devDependencies": {
    "@electron/asar": "^4.0.1",
    "@types/node": "^24.3.1",
    "dmg-license": "^1.0.11",
    "dotenv": "^16.4.5",
    "electron": "^42.10.1",
    "electron-builder": "^26.15.0",
    "electron-vite": "^5.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
