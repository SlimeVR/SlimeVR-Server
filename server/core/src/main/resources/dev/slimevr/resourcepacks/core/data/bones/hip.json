{
  "$schema": "../../schemas/v1/bone.schema.json",
  "key": "slimevr:hip",
  "nameKey": "slimevr:bone.hip",
  "batterySources": [
    "slimevr:hip",
    "slimevr:lower_waist",
    "slimevr:upper_waist",
    "slimevr:lower_chest",
    "slimevr:upper_chest"
  ],
  "candidateSources": [
    "slimevr:hip",
    "slimevr:lower_waist",
    "slimevr:upper_waist",
    "slimevr:lower_chest",
    "slimevr:upper_chest"
  ],
  "parent": "slimevr:lower_waist",
  "tailOffset": {"terms": [{"proportion": "slimevr:hip", "direction": {"x": 0, "y": -1, "z": 0}}]},
  "rotationFallback": {"type": "none"},
  "constraint": {"type": "twistSwing", "twistDegrees": 60, "swingDegrees": 120},
  "outputs": {
    "driver": {"supported": true},
    "vmc": {"name": "Hips"},
    "vrchat": {
      "emit": {
        "/tracking/trackers/1/position": {"from": "position", "value": [{"scale": {"z": -1}}]},
        "/tracking/trackers/1/rotation": {
          "from": "rotation",
          "value": [{"scale": {"x": -1, "y": -1}}, {"euler": {"order": "YXZ"}}]
        }
      }
    }
  }
}
