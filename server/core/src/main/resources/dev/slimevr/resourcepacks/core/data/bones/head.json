{
  "$schema": "../../schemas/v1/bone.schema.json",
  "key": "slimevr:head",
  "nameKey": "slimevr:bone.head",
  "tailOffset": {"terms": [{"proportion": "slimevr:head", "direction": {"x": 0, "y": 0, "z": 1}}]},
  "rotationFallback": {"type": "copy", "source": "slimevr:neck"},
  "outputs": {
    "vmc": {"name": "Head"},
    "vrchat": {
      "required": true,
      "emit": {
        "/tracking/trackers/head/position": {"from": "position", "value": [{"scale": {"z": -1}}]}
      }
    }
  },
  "inputs": {"vrchat": {"address": "/tracking/vrsystem/head/pose"}}
}
