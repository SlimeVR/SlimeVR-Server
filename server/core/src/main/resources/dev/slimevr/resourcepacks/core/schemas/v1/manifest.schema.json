{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "nameKey", "descriptionKey", "version", "authors"],
  "properties": {
    "$schema": {"type": "string"},
    "formatVersion": {"const": 1},
    "id": {"$ref": "common.schema.json#/$defs/key"},
    "nameKey": {"$ref": "common.schema.json#/$defs/translationKey"},
    "descriptionKey": {"$ref": "common.schema.json#/$defs/translationKey"},
    "version": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "integer", "minimum": 0}
    },
    "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
