{
  "$schema": "../../schemas/v1/bone.schema.json",
  "key": "slimevr:left_little_toe",
  "nameKey": "slimevr:bone.left_little_toe",
  "mirror": "slimevr:right_little_toe",
  "candidateSources": ["slimevr:left_little_toe"],
  "parent": "slimevr:left_foot",
  "headOffset": {
    "terms": [{"proportion": "slimevr:foot_length", "direction": {"x": -0.26, "y": 0, "z": 0}}]
  },
  "tailOffset": {
    "terms": [{"proportion": "slimevr:foot_length", "direction": {"x": 0, "y": 0, "z": -0.18}}]
  },
  "rotationFallback": {
    "type": "firstActive",
    "sources": [
      "slimevr:left_ring_toe",
      "slimevr:left_middle_toe",
      "slimevr:left_index_toe",
      "slimevr:left_big_toe",
      "slimevr:left_foot"
    ]
  },
  "outputs": {
    "vmc": {"name": "LeftLittleToe"},
    "vrchat": {
      "emit": {
        "/avatar/parameters/ToeBentLeft5Bool": {
          "from": "rotation",
          "relativeTo": "slimevr:left_foot",
          "value": [{"euler": "x"}, {"greaterThan": 15}]
        },
        "/avatar/parameters/ToeSplayLeft5": {
          "from": "rotation",
          "relativeTo": "slimevr:left_foot",
          "value": [{"euler": "z"}, {"lessThan": -7}]
        },
        "/avatar/parameters/ToeLeft5Float": {
          "from": "rotation",
          "relativeTo": "slimevr:left_foot",
          "value": [{"euler": "x"}, {"divide": 90}, {"clamp": [-1, 1]}]
        },
        "/avatar/parameters/ToeSplayLeft5Float": {
          "from": "rotation",
          "relativeTo": "slimevr:left_foot",
          "value": [{"euler": "z"}, {"divide": 90}, {"clamp": [-1, 1]}]
        },
        "/avatar/parameters/TipToesLeft": {
          "from": "rotation",
          "relativeTo": "slimevr:left_foot",
          "value": [{"euler": "x"}, {"lessThan": -14}]
        }
      }
    }
  }
}
